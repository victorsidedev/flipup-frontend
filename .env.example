# Copy to .env.development.local for local overrides.
# Browser-visible API prefix. Trailing slashes are removed.
VITE_API_BASE_URL=/api

# Used only by the Vite development proxy; never bundled into the frontend.
API_PROXY_TARGET=http://127.0.0.1:8000

# For production, set VITE_API_BASE_URL in Render instead, for example:
# VITE_API_BASE_URL=https://your-backend.onrender.com
# Include /api only if the backend actually serves its endpoints under /api.
